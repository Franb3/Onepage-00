---
// ========================================================================
// Layout.astro — Estructura base de todas las páginas (<head>, tema, fuente)
// ------------------------------------------------------------------------
// * Cada página lo usa así:  <Layout title="..."> contenido </Layout>
// * Colores y tema: src/styles/global.css
// ========================================================================
import "@fontsource/concert-one/latin-400.css"; // * Fuente del sitio
import "../styles/global.css";
import { site } from "../config/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.name, description = site.description } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="utf-8" />
    {/* ? viewport-fit=cover permite usar toda la pantalla en iPhone con "muesca"; el CSS deja los márgenes seguros */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* * Color de la barra del navegador en el móvil, según el tema del sistema */}
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#030303" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_ES" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* ! Este script debe ir aquí, antes de que se pinte la página: evita el parpadeo de blanco al cargar en modo oscuro */}
    {/* * 1) Elige el tema: el guardado por la persona o, si no hay, el del sistema. 2) Marca la página con la clase "js" */}
    {/* ? Está escrito en JavaScript antiguo (var, sin flechas) a propósito, para que funcione en móviles viejos */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var theme = "light";
        try {
          var saved = localStorage.getItem("theme");
          if (saved === "dark" || saved === "light") {
            theme = saved;
          } else if (window.matchMedia && matchMedia("(prefers-color-scheme: dark)").matches) {
            theme = "dark";
          }
        } catch (e) {}
        root.setAttribute("data-theme", theme);
        root.className += " js";
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
