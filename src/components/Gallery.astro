---
// ========================================================================
// Gallery.astro — Galería de fotos en cuadrícula
// ------------------------------------------------------------------------
// * Estilos: src/styles/gallery.css
// TODO: Para agregar una foto, ponla en src/assets/gallery/ con el nombre
//       nieveN.webp y añade su número a la lista "order".
// ========================================================================
import "../styles/gallery.css";
import { Picture } from "astro:assets";

// * Carga todas las fotos de la carpeta de una vez (con sus medidas, que Astro necesita para optimizarlas)
const files = import.meta.glob<{ default: ImageMetadata }>("../assets/gallery/*.webp", { eager: true });

// * Orden en que aparecen las fotos:
const order = [1, 2, 3, 4, 5, 6, 7, 8, 12, 10, 11, 9];
const images = order.map((n, i) => ({
  src: files[`../assets/gallery/nieve${n}.webp`].default,
  alt: `Paisaje nevado ${i + 1}`,
}));
---

<section id="gallery" class="gallery" aria-label="Galería de fotos">
  {/* * widths + sizes: cada dispositivo descarga la versión que necesita (400, 800 o 1200 px de ancho) */}
  {/* * WebP moderno con JPG de respaldo; "lazy" = la foto se descarga cuando está por aparecer en pantalla */}
  {images.map((image) => (
    <Picture
      src={image.src}
      alt={image.alt}
      widths={[400, 800, 1200]}
      sizes="(max-width: 640px) 100vw, (max-width: 1200px) 50vw, 400px"
      formats={["webp"]}
      fallbackFormat="jpg"
      quality={74}
      loading="lazy"
      decoding="async"
    />
  ))}
</section>
